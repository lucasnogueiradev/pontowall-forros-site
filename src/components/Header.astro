---
import { WHATSAPP_URL, INSTAGRAM_URL, FACEBOOK_URL, PHONE } from '../consts';
import logoImg from '../assets/logo-light.webp';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/#servicos', label: 'Forro de Isopor' },
  { href: '/#servicos', label: 'Fibra Mineral' },
  { href: '/#servicos', label: 'Drywall' },
  { href: '/blog', label: 'Blog' },
  { href: '/#contato', label: 'Contato' },
];
---

<!-- Top Bar -->
<div class="top-bar">
  <div class="container top-bar-inner">
    

    <div class="top-bar-contact">
      <a href={`tel:${PHONE.replace(/\D/g,'')}`} class="contact-item highlight-call">
        <i class="fas fa-phone-alt"></i>
        <span>Ligue agora: {PHONE}</span>
      </a>
    </div>
  </div>
</div>

<!-- Navigation -->
<nav id="navbar" class="main-nav">
  <div class="container nav-inner">
    <!-- Logo mobile -->
    <a href="/" class="nav-logo" aria-label="Pontowall Forros">
      <img src={logoImg.src} alt="Pontowall" width="120" height="39" />
    </a>

    <!-- Links -->
    <ul class="nav-links" id="nav-links">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class:list={[
              'nav-link',
              { active: link.href === currentPath || (link.href === '/blog' && currentPath.startsWith('/blog')) }
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Socials -->
    <div class="nav-socials">
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener" title="Instagram Pontowall" aria-label="Instagram">
        <i class="fab fa-instagram"></i>
      </a>
      <a href={FACEBOOK_URL} target="_blank" rel="noopener" title="Facebook Pontowall" aria-label="Facebook">
        <i class="fab fa-facebook-f"></i>
      </a>
    </div>

    <!-- Hamburger -->
    <button class="hamburger" id="hamburger" aria-label="Abrir menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<style>
  /* TOP BAR */
  .top-bar {
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 0.75rem 0;
  }

  .top-bar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .top-bar-logo img {
    height: 52px;
    width: auto;
  }

  .top-bar-contact {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--dark);
    font-weight: 600;
    font-size: 0.95rem;
    transition: var(--transition);
  }

  .contact-item i { font-size: 1rem; color: var(--primary); }
  .contact-item.whatsapp i { color: var(--success); }

  .contact-item:hover {
    color: var(--primary);
  }

  .highlight-call {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    background: #ff6b00; /* Laranja chamativo */
    padding: 0.5rem 1.2rem;
    border-radius: 50px;
    box-shadow: 0 4px 15px rgba(255, 107, 0, 0.3);
  }
  
  .highlight-call i {
    color: #fff !important; /* Forçar ícone branco */
  }
  
  .highlight-call:hover {
    background: #e66000;
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 107, 0, 0.4);
  }

  /* NAV */
  .main-nav {
    background: var(--primary);
    position: sticky;
    top: 0;
    z-index: 999;
    box-shadow: 0 2px 20px rgba(22, 83, 173, 0.4);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 0;
    padding-bottom: 0;
    min-height: 54px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    margin-right: 1rem;
  }

  .nav-logo img {
    height: 36px;
    width: auto;
    border-radius: 6px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .nav-link {
    display: block;
    padding: 0.9rem 1rem;
    color: rgba(255,255,255,0.85);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    transition: var(--transition);
    border-bottom: 3px solid transparent;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link.active {
    color: white;
    border-bottom-color: var(--secondary);
  }

  .nav-socials {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  .nav-socials a {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.12);
    color: white;
    text-decoration: none;
    font-size: 0.95rem;
    transition: var(--transition);
  }

  .nav-socials a:hover {
    background: rgba(255,255,255,0.25);
    transform: translateY(-2px);
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    margin-left: auto;
  }

  .hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: white;
    border-radius: 2px;
    transition: var(--transition);
  }

  /* Mobile Nav */
  @media (max-width: 900px) {
    .top-bar-inner {
      padding: 0.5rem 0;
    }
    .highlight-call {
      font-size: 1rem;
      padding: 0.4rem 0.8rem;
    }
  }

  @media (max-width: 768px) {
    .top-bar-logo img {
      height: 40px;
    }

    .nav-logo {
      display: block;
    }

    .nav-socials {
      display: none;
    }

    .hamburger {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--primary-dark);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem 0;
      box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .nav-links.open {
      display: flex;
    }

    .nav-link {
      padding: 1rem 1.5rem;
      border-bottom: none;
      border-left: 3px solid transparent;
    }

    .nav-link:hover, .nav-link.active {
      border-bottom: none;
      border-left-color: var(--secondary);
      background: rgba(255,255,255,0.08);
    }

    .nav-inner {
      position: relative;
    }
  }
</style>

<script>
  const hamburger = document.getElementById('hamburger');
  const navLinks = document.getElementById('nav-links');

  hamburger?.addEventListener('click', () => {
    const isOpen = navLinks?.classList.toggle('open');
    hamburger.setAttribute('aria-expanded', String(isOpen));
  });

  // Fechar ao clicar em link
  navLinks?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      navLinks.classList.remove('open');
      hamburger?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
